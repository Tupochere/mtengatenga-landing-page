{
  "name": "mtengatenga-museum-ar-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Demo landing page for the Mtengatenga Museum AR Experience",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/styles.css --watch",
    "build": "npm run build:css",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
